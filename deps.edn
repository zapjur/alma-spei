{:paths ["src/api" "src/common" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ring/ring-core {:mvn/version "1.15.6"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        metosin/reitit-ring {:mvn/version "0.11.0"}
        metosin/reitit-malli {:mvn/version "0.11.0"}
        metosin/reitit-middleware {:mvn/version "0.11.0"}
        integrant/integrant {:mvn/version "1.0.1"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}
        org.postgresql/postgresql {:mvn/version "42.7.14"}
        migratus/migratus {:mvn/version "1.6.8"}
        metosin/malli {:mvn/version "0.20.3"}
        metosin/muuntaja {:mvn/version "0.6.12"}}
 :aliases
 {:run {:main-opts ["-m" "alma-spei.api.main"]}
  :dev {:extra-paths ["dev"]}
  :repl {:extra-paths ["dev"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                      reply/reply {:mvn/version "0.5.1"}
                      cider/cider-nrepl {:mvn/version "0.63.1"}
                      org.clojure/tools.namespace {:mvn/version "1.5.1"}}
         :main-opts ["-m" "alma-spei.dev.repl"]}
  :test-repl {:extra-paths ["test/dev"]
              :main-opts ["-m" "alma-spei.dev.reload-test"]}
  :migrate {:main-opts ["-m" "alma-spei.api.db.migrations"]}
  :test {:extra-paths ["dev" "test/api" "test/common"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "alma-spei.dev.test-runner" "unit"]}
  :integration {:extra-paths ["dev" "test/integration" "test/resources"]
                :main-opts ["-m" "alma-spei.dev.test-runner" "integration"]}
  :ui {:replace-paths ["src/ui" "src/common" "test/ui" "test/common"]
       :replace-deps {org.clojure/clojure {:mvn/version "1.12.6"}
                      org.clojure/clojurescript {:mvn/version "1.12.145"}
                      thheller/shadow-cljs {:mvn/version "3.5.7"}
                      reagent/reagent {:mvn/version "2.0.1"}
                      re-frame/re-frame {:mvn/version "1.4.7"}
                      metosin/malli {:mvn/version "0.20.3"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.20"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "dev" "bb.edn"]}
  :format {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
           :main-opts ["-m" "cljfmt.main"]}}}
